      {"type": "mcp_tool_result", "tool_use_id": "mcptoolu_synth_03", "content": [{"type": "text", "text": "kite: a light frame covered with cloth."}]},
      {"type": "web_search_tool_result", "tool_use_id": "srvtoolu_synth_02", "content": [{"type": "web_search_result", "title": "Synthetic forecast", "url": "https://example.test/forecast", "encrypted_content": "c3ludGhldGlj"}]},
      {"type": "tool_result", "tool_use_id": "toolu_synth_05"}
    ]}
  ]
